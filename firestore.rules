rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Global Hardened Helpers
    // ==========================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'nashwann1991@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ==========================================
    // Validation Blueprints
    // ==========================================
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'status', 'authProvider', 'avatar', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role in ['user', 'creator', 'admin']
        && data.status in ['active', 'suspended']
        && (!('authProvider' in data) || (data.authProvider is string && data.authProvider in ['password', 'google']))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && data.uid is string && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.grantedAt is timestamp;
    }

    function isValidPlan(data, planId) {
      return data.keys().hasAll(['planId', 'name', 'priceMinor', 'currency', 'duration', 'creditsGranted', 'active'])
        && data.keys().hasOnly(['planId', 'name', 'nameAr', 'description', 'priceMinor', 'currency', 'duration', 'durationDays', 'creditsGranted', 'allowedModels', 'maxVideoDurationSeconds', 'active'])
        && data.planId is string && data.planId == planId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (!('nameAr' in data) || (data.nameAr is string && data.nameAr.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.priceMinor is number && data.priceMinor >= 0
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.duration in ['daily', '5days', 'weekly', 'monthly', 'annual', 'custom']
        && (!('durationDays' in data) || (data.durationDays is number && data.durationDays >= 0))
        && data.creditsGranted is number && data.creditsGranted >= 0
        && (!('allowedModels' in data) || (data.allowedModels is list && data.allowedModels.size() <= 20 && (data.allowedModels.size() == 0 || data.allowedModels[0] is string)))
        && (!('maxVideoDurationSeconds' in data) || (data.maxVideoDurationSeconds is number && data.maxVideoDurationSeconds >= 0))
        && data.active is bool;
    }

    function isValidSubscription(data, subId) {
      return data.keys().hasAll(['subscriptionId', 'uid', 'planId', 'status', 'startsAt', 'expiresAt'])
        && data.keys().hasOnly(['subscriptionId', 'uid', 'planId', 'status', 'startsAt', 'expiresAt', 'renewalStatus', 'paymentReference'])
        && data.subscriptionId is string && data.subscriptionId == subId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 128
        && data.status in ['active', 'expired', 'cancelled']
        && data.startsAt is string && data.startsAt.size() <= 64
        && data.expiresAt is string && data.expiresAt.size() <= 64
        && (!('renewalStatus' in data) || (data.renewalStatus is string && data.renewalStatus.size() <= 50))
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 200));
    }

    function isValidWallet(data, userId) {
      return data.keys().hasAll(['uid', 'availableCredits', 'reservedCredits'])
        && data.keys().hasOnly(['uid', 'availableCredits', 'reservedCredits', 'totalEarnedOrPurchased', 'updatedAt'])
        && data.uid is string && data.uid == userId
        && data.availableCredits is number && data.availableCredits >= 0
        && data.reservedCredits is number && data.reservedCredits >= 0
        && (!('totalEarnedOrPurchased' in data) || (data.totalEarnedOrPurchased is number && data.totalEarnedOrPurchased >= 0))
        && (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidLedger(data, txId) {
      return data.keys().hasAll(['transactionId', 'uid', 'type', 'amount', 'balanceBefore', 'balanceAfter', 'createdAt'])
        && data.keys().hasOnly(['transactionId', 'uid', 'type', 'amount', 'balanceBefore', 'balanceAfter', 'referenceId', 'idempotencyKey', 'description', 'createdAt'])
        && data.transactionId is string && data.transactionId == txId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.type in ['credit_purchase', 'plan_grant', 'generation_hold', 'generation_finalize', 'generation_refund', 'activation_redeem', 'admin_adjustment']
        && data.amount is number
        && data.balanceBefore is number
        && data.balanceAfter is number
        && (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 128))
        && (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 128))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidActivationKey(data, keyId) {
      return data.keys().hasAll(['keyId', 'keyHash', 'status', 'maxActivations', 'activationCount'])
        && data.keys().hasOnly(['keyId', 'keyHash', 'planId', 'creditsAmount', 'status', 'expiresAt', 'maxActivations', 'activationCount', 'assignedUid', 'createdBy', 'redeemedAt'])
        && data.keyId is string && data.keyId == keyId
        && data.keyHash is string && data.keyHash.size() <= 256
        && (!('planId' in data) || (data.planId is string && data.planId.size() <= 128))
        && (!('creditsAmount' in data) || (data.creditsAmount is number && data.creditsAmount >= 0))
        && data.status in ['active', 'redeemed', 'revoked', 'expired']
        && (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64))
        && data.maxActivations is number && data.maxActivations >= 1
        && data.activationCount is number && data.activationCount >= 0
        && (!('assignedUid' in data) || (data.assignedUid is string && data.assignedUid.size() <= 128))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('redeemedAt' in data) || (data.redeemedAt is string && data.redeemedAt.size() <= 64));
    }

    function isValidGenerationJob(data, jobId) {
      return data.keys().hasAll(['jobId', 'uid', 'type', 'providerId', 'modelId', 'status', 'createdAt'])
        && data.keys().hasOnly(['jobId', 'uid', 'type', 'providerId', 'modelId', 'prompt', 'status', 'estimatedCost', 'reservedCredits', 'actualCost', 'resultUrl', 'errorCode', 'metadata', 'createdAt', 'completedAt'])
        && data.jobId is string && data.jobId == jobId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.type in ['video', 'image', 'speech', 'prompt_expand']
        && data.providerId is string && data.providerId.size() <= 128
        && data.modelId is string && data.modelId.size() <= 128
        && (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 5000))
        && data.status in ['queued', 'processing', 'succeeded', 'failed', 'cancelled']
        && (!('estimatedCost' in data) || data.estimatedCost is number)
        && (!('reservedCredits' in data) || data.reservedCredits is number)
        && (!('actualCost' in data) || data.actualCost is number)
        && (!('resultUrl' in data) || (data.resultUrl is string && data.resultUrl.size() <= 1000))
        && (!('errorCode' in data) || (data.errorCode is string && data.errorCode.size() <= 200))
        && (!('metadata' in data) || data.metadata is map)
        && (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('completedAt' in data) || data.completedAt is timestamp || (data.completedAt is string && data.completedAt.size() <= 64));
    }

    function isValidProvider(data, providerId) {
      return data.keys().hasAll(['providerId', 'name', 'enabled'])
        && data.keys().hasOnly(['providerId', 'name', 'enabled', 'capabilities', 'models', 'secretReference', 'pricingVersion', 'updatedAt'])
        && data.providerId is string && data.providerId == providerId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.enabled is bool
        && (!('capabilities' in data) || (data.capabilities is list && data.capabilities.size() <= 20 && (data.capabilities.size() == 0 || data.capabilities[0] is string)))
        && (!('models' in data) || (data.models is list && data.models.size() <= 50 && (data.models.size() == 0 || data.models[0] is string)))
        && (!('secretReference' in data) || (data.secretReference is string && data.secretReference.size() <= 200))
        && (!('pricingVersion' in data) || (data.pricingVersion is string && data.pricingVersion.size() <= 50))
        && (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidCredential(data, credId) {
      return data.keys().hasAll(['credentialId', 'uid', 'providerId', 'encryptedSecret', 'status', 'createdAt'])
        && data.keys().hasOnly(['credentialId', 'uid', 'providerId', 'encryptedSecret', 'keyMask', 'status', 'createdAt', 'lastValidatedAt'])
        && data.credentialId is string && data.credentialId == credId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128
        && data.encryptedSecret is string && data.encryptedSecret.size() >= 1 && data.encryptedSecret.size() <= 2000
        && (!('keyMask' in data) || (data.keyMask is string && data.keyMask.size() <= 50))
        && data.status in ['active', 'invalid', 'revoked']
        && data.createdAt is timestamp
        && (!('lastValidatedAt' in data) || data.lastValidatedAt is timestamp);
    }

    function isValidPayment(data, paymentId) {
      return data.keys().hasAll(['paymentId', 'uid', 'amountMinor', 'currency', 'method', 'status', 'createdAt'])
        && data.keys().hasOnly(['paymentId', 'uid', 'planId', 'amountMinor', 'currency', 'method', 'status', 'proofAttachmentUrl', 'providerReference', 'adminNotes', 'idempotencyKey', 'createdAt', 'confirmedAt'])
        && data.paymentId is string && data.paymentId == paymentId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && (!('planId' in data) || (data.planId is string && data.planId.size() <= 128))
        && data.amountMinor is number && data.amountMinor >= 0
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.method in ['manual_bank', 'manual_crypto', 'electronic_stripe', 'activation_key']
        && data.status in ['pending', 'confirmed', 'rejected', 'refunded']
        && (!('proofAttachmentUrl' in data) || (data.proofAttachmentUrl is string && data.proofAttachmentUrl.size() <= 1000))
        && (!('providerReference' in data) || (data.providerReference is string && data.providerReference.size() <= 200))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 128))
        && data.createdAt is timestamp
        && (!('confirmedAt' in data) || data.confirmedAt is timestamp);
    }

    function isValidWebhookEvent(data, eventId) {
      return data.keys().hasAll(['eventId', 'providerId', 'externalEventId', 'status', 'processedAt'])
        && data.keys().hasOnly(['eventId', 'providerId', 'externalEventId', 'status', 'processedAt'])
        && data.eventId is string && data.eventId == eventId
        && data.providerId is string && data.providerId.size() <= 128
        && data.externalEventId is string && data.externalEventId.size() <= 200
        && data.status in ['pending', 'processed', 'failed', 'duplicate']
        && data.processedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['logId', 'actorUid', 'action', 'timestamp'])
        && data.keys().hasOnly(['logId', 'actorUid', 'action', 'targetType', 'targetId', 'timestamp', 'safeMetadata'])
        && data.logId is string && data.logId == logId
        && data.actorUid is string && data.actorUid.size() <= 128
        && data.action is string && data.action.size() <= 100
        && (!('targetType' in data) || (data.targetType is string && data.targetType.size() <= 100))
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && data.timestamp is timestamp
        && (!('safeMetadata' in data) || data.safeMetadata is map);
    }

    // ==========================================
    // Collection Rules
    // ==========================================

    // Users: Registered account profiles (PII restricted to Owner or Admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ((incoming().role == 'user' && incoming().status == 'active') || isAdmin());
      allow update: if isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatar', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins: Trusted administrator registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidAdmin(incoming(), userId) && incoming().grantedAt == request.time;
      allow update, delete: if isValidId(userId) && isAdmin();
    }

    // Plans: Publicly readable when active; admin write
    match /plans/{planId} {
      allow get: if isValidId(planId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isAdmin();
      allow create, update: if isValidId(planId) && isAdmin() && isValidPlan(incoming(), planId);
      allow delete: if isValidId(planId) && isAdmin();
    }

    // Subscriptions: Owner or Admin read; Admin write
    match /subscriptions/{subscriptionId} {
      allow get: if isValidId(subscriptionId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isValidId(subscriptionId) && isAdmin() && isValidSubscription(incoming(), subscriptionId);
      allow delete: if isValidId(subscriptionId) && isAdmin();
    }

    // Wallets: Owner or Admin read; Admin write
    match /wallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isAdmin() && isValidWallet(incoming(), userId);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Ledger: Owner or Admin read; Admin write
    match /ledger/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isValidId(txId) && isAdmin() && isValidLedger(incoming(), txId);
      allow delete: if isValidId(txId) && isAdmin();
    }

    // Activation Keys: Admin only
    match /activationKeys/{keyId} {
      allow get: if isValidId(keyId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(keyId) && isAdmin() && isValidActivationKey(incoming(), keyId);
      allow delete: if isValidId(keyId) && isAdmin();
    }

    // Generation Jobs: Owner or Admin read; Admin write
    match /generationJobs/{jobId} {
      allow get: if isValidId(jobId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isValidId(jobId) && isAdmin() && isValidGenerationJob(incoming(), jobId);
      allow delete: if isValidId(jobId) && isAdmin();
    }

    // Providers: Authenticated read; Admin write
    match /providers/{providerId} {
      allow get: if isValidId(providerId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(providerId) && isAdmin() && isValidProvider(incoming(), providerId);
      allow delete: if isValidId(providerId) && isAdmin();
    }

    // Customer API Credentials: Owner or Admin
    match /customerApiCredentials/{credId} {
      allow get: if isValidId(credId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(credId)
        && isSignedIn()
        && isValidCredential(incoming(), credId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(credId)
        && isSignedIn()
        && isValidCredential(incoming(), credId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['encryptedSecret', 'keyMask', 'status', 'lastValidatedAt']))
        );
      allow delete: if isValidId(credId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // Payments: Owner can read and create pending payments; Admin manages approval
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(paymentId)
        && isSignedIn()
        && isValidPayment(incoming(), paymentId)
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;
      allow update: if isValidId(paymentId)
        && isAdmin()
        && isValidPayment(incoming(), paymentId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && existing().status == 'pending';
      allow delete: if isValidId(paymentId) && isAdmin();
    }

    // Webhook Events & Audit Logs: Admin only
    match /webhookEvents/{eventId} {
      allow get: if isValidId(eventId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(eventId) && isAdmin() && isValidWebhookEvent(incoming(), eventId);
      allow delete: if isValidId(eventId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming(), logId) && incoming().timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
